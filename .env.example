# Omgevingsvariabelen voor de website, het klantportaal en het KMS.
# Kopieer naar .env.local voor lokaal werken; in productie staan ze in Vercel
# (Project → Settings → Environment Variables). Vul hier NOOIT echte geheimen in.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://ldbyljadqququzoicyid.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://ldbyljadqququzoicyid.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- KMS (/dashboard) ---
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=

# --- Inloggen met Microsoft / Google (portaal en KMS) ---
# Zet op 1 om de knop "Inloggen met Microsoft" of "Inloggen met Google" te tonen.
# Leeg of weggelaten: knop verborgen. Zet een provider pas aan als hij in Supabase
# is ingesteld (Authentication → Sign In / Providers). Uitleg: docs/sso-instellen.md
# Na het wijzigen opnieuw deployen: NEXT_PUBLIC_-variabelen worden bij de build ingebakken.
NEXT_PUBLIC_SSO_MICROSOFT=
NEXT_PUBLIC_SSO_GOOGLE=

# --- Site en mail ---
NEXT_PUBLIC_SITE_URL=https://frederiks-bedrijfskleding-website.vercel.app
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEAD_NOTIFY_EMAIL=
NIEUWSBRIEF_FROM_EMAIL=
CAMPAGNE_FROM_EMAIL=
NEXT_PUBLIC_GA_ID=

# --- Overig ---
ANTHROPIC_API_KEY=
CRON_SECRET=
TAKEN_CRON_SECRET=
DOCUMENT_BASIS_URL=

# --- Boekhouding: Moneybird ---
# Persoonlijk API-token uit Moneybird (je naam rechtsboven > Ontwikkelaars >
# Persoonlijke API-tokens) met rechten voor Verkoop, Contacten en Instellingen.
# Zonder token werkt alles behalve doorzetten naar Moneybird; de export (CSV en
# UBL) werkt altijd. Uitleg: docs/boekhouding-koppelen.md
MONEYBIRD_API_TOKEN=
# Het lange getal in de adresbalk van Moneybird: https://moneybird.com/<dit getal>/...
MONEYBIRD_ADMINISTRATIE_ID=
